---
import type { CollectionEntry } from 'astro:content';
import Tag from '../ui/Tag.astro';
import Button from '../ui/Button.astro';

interface Props {
  project: CollectionEntry<'projects'>;
  featured?: boolean;
}

const { project, featured = false } = Astro.props;
const { title, client, description, tags, year, metrics, links } = project.data;
const slug = project.id;
---

<article class:list={[
  'group relative flex flex-col p-6 rounded-xl border border-[var(--color-border)] bg-[var(--color-bg-secondary)]',
  'hover:border-[var(--color-border-hover)] transition-all duration-300',
  featured && 'md:col-span-1',
]}>

  <!-- Client + year -->
  <div class="flex items-center justify-between mb-4">
    <span class="font-mono text-xs text-[var(--color-accent)] uppercase tracking-widest">
      {client}
    </span>
    <span class="font-mono text-xs text-[var(--color-text-secondary)]">{year}</span>
  </div>

  <!-- Title -->
  <h3 class="text-lg font-bold text-[var(--color-text-primary)] mb-3 group-hover:text-[var(--color-accent)] transition-colors duration-200 leading-snug m-0">
    <a href={`/projects/${slug}`} class="stretched-link text-inherit no-underline">
      {title}
    </a>
  </h3>

  <!-- Description -->
  <p class="text-sm text-[var(--color-text-secondary)] leading-relaxed mb-5 flex-1">
    {description}
  </p>

  <!-- Metrics (if any) -->
  {metrics && metrics.length > 0 && (
    <div class="flex flex-wrap gap-4 mb-5 pb-5 border-b border-[var(--color-border)]">
      {metrics.map((m) => (
        <div>
          <div class="text-xl font-bold text-[var(--color-accent)]">{m.value}</div>
          <div class="text-xs text-[var(--color-text-secondary)]">{m.label}</div>
        </div>
      ))}
    </div>
  )}

  <!-- Tags -->
  <div class="flex flex-wrap gap-1.5 mb-5">
    {tags.slice(0, 5).map((tag) => (
      <Tag label={tag} variant="default" size="sm" />
    ))}
    {tags.length > 5 && (
      <Tag label={`+${tags.length - 5}`} variant="outline" size="sm" />
    )}
  </div>

  <!-- Links -->
  <div class="flex items-center gap-3 mt-auto">
    <a
      href={`/projects/${slug}`}
      class="inline-flex items-center gap-1.5 text-sm font-medium text-[var(--color-accent)] hover:text-[var(--color-accent-hover)] transition-colors no-underline"
    >
      View details
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="m9 18 6-6-6-6"/>
      </svg>
    </a>
    {links?.repo && (
      <a
        href={links.repo}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 text-sm text-[var(--color-text-secondary)] hover:text-[var(--color-text-primary)] transition-colors no-underline"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.2c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.4 5.4 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/>
          <path d="M9 18c-4.51 2-5-2-7-2"/>
        </svg>
        Code
      </a>
    )}
  </div>

</article>

<style>
  .stretched-link::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }
  .stretched-link + * {
    position: relative;
    z-index: 2;
  }
</style>
