---
import { SKILLS, UI } from '../../config';
import SectionHeading from '../ui/SectionHeading.astro';
import Tag from '../ui/Tag.astro';

const iconMap: Record<string, string> = {
  cpu: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="4" width="16" height="16" rx="2"/><rect x="9" y="9" width="6" height="6"/><path d="M15 2v2M9 2v2M2 9h2M2 15h2M22 9h-2M22 15h-2M15 22v-2M9 22v-2"/></svg>`,
  cloud: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z"/></svg>`,
  'circuit-board': `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M11 9h4a2 2 0 0 0 2-2V3M7 9H3M7 15H3M11 15h4a2 2 0 0 1 2 2v4M7 21v-4a2 2 0 0 1 2-2h1M12 3v6M12 15v6"/></svg>`,
  wifi: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 13a10 10 0 0 1 14 0"/><path d="M8.5 16.5a5 5 0 0 1 7 0"/><path d="M2 8.82a15 15 0 0 1 20 0"/><line x1="12" x2="12.01" y1="20" y2="20"/></svg>`,
};
---

<section class="section bg-[var(--color-bg-secondary)]">
  <div class="container">
    <SectionHeading title="Technical Skills" subtitle={UI.skillsSectionTitle} />

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {SKILLS.map((skill) => (
        <div class="group p-6 rounded-xl border border-[var(--color-border)] bg-[var(--color-bg-primary)] hover:border-[var(--color-border-hover)] transition-all duration-300">
          <!-- Category header -->
          <div class="flex items-center gap-3 mb-5">
            <div class="flex items-center justify-center w-9 h-9 rounded-lg bg-[var(--color-accent-dim)] text-[var(--color-accent)]"
                 set:html={iconMap[skill.icon] ?? iconMap['cpu']} />
            <h3 class="text-base font-semibold text-[var(--color-text-primary)] m-0">
              {skill.category}
            </h3>
          </div>
          <!-- Tags -->
          <div class="flex flex-wrap gap-2">
            {skill.items.map((item) => (
              <Tag label={item} variant="outline" size="sm" />
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
