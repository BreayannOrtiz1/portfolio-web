---
import { AUTHOR, SOCIAL, UI } from '../../config';
import Button from '../ui/Button.astro';

// Icons as inline SVG strings for zero-dependency approach
---

<section class="relative min-h-screen flex items-center overflow-hidden">
  <!-- Subtle grid background -->
  <div class="absolute inset-0 hero-grid opacity-[0.03] pointer-events-none"></div>
  <!-- Accent glow -->
  <div class="absolute top-1/3 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] rounded-full bg-[var(--color-accent)] opacity-[0.04] blur-[120px] pointer-events-none"></div>

  <div class="container relative z-10 py-32">
    <div class="max-w-3xl">

      <!-- Status badge -->
      <div class="inline-flex items-center gap-2 mb-8 px-3 py-1.5 rounded-full border border-[var(--color-border)] bg-[var(--color-bg-secondary)]">
        <span class="w-2 h-2 rounded-full bg-[var(--color-accent)] animate-pulse"></span>
        <span class="font-mono text-xs text-[var(--color-text-secondary)]">Available for new projects</span>
      </div>

      <!-- Name & Title -->
      <h1 class="mb-4 text-[var(--color-text-primary)]">
        {AUTHOR.name}
      </h1>

      <p class="text-xl md:text-2xl font-mono text-[var(--color-accent)] mb-6 tracking-tight">
        {UI.heroTagline}
      </p>

      <!-- Bio -->
      <p class="text-lg text-[var(--color-text-secondary)] leading-relaxed max-w-2xl mb-10">
        {AUTHOR.bio}
      </p>

      <!-- Quick stats -->
      <div class="flex flex-wrap gap-8 mb-12 pb-12 border-b border-[var(--color-border)]">
        <div>
          <div class="text-3xl font-bold text-[var(--color-text-primary)]">4+</div>
          <div class="text-sm text-[var(--color-text-secondary)] mt-0.5">Years in IoT</div>
        </div>
        <div>
          <div class="text-3xl font-bold text-[var(--color-text-primary)]">61</div>
          <div class="text-sm text-[var(--color-text-secondary)] mt-0.5">Stations Deployed</div>
        </div>
        <div>
          <div class="text-3xl font-bold text-[var(--color-text-primary)]">3</div>
          <div class="text-sm text-[var(--color-text-secondary)] mt-0.5">Industry Sectors</div>
        </div>
        <div>
          <div class="text-3xl font-bold text-[var(--color-text-primary)]">B2</div>
          <div class="text-sm text-[var(--color-text-secondary)] mt-0.5">English Level</div>
        </div>
      </div>

      <!-- CTA buttons -->
      <div class="flex flex-wrap gap-4 items-center">
        <Button href={UI.heroCtaPrimary.href} variant="secondary" size="lg">
          {UI.heroCtaPrimary.label}
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="m9 18 6-6-6-6"/>
          </svg>
        </Button>
        <Button href={SOCIAL.linkedin} variant="ghost" size="lg" external>
          LinkedIn
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" x2="21" y1="14" y2="3"/>
          </svg>
        </Button>
        <Button href={SOCIAL.email} variant="ghost" size="lg">
          {AUTHOR.email}
        </Button>
      </div>

    </div>
  </div>
</section>

<style>
  .hero-grid {
    background-image:
      linear-gradient(var(--color-accent) 1px, transparent 1px),
      linear-gradient(90deg, var(--color-accent) 1px, transparent 1px);
    background-size: 60px 60px;
  }
</style>
