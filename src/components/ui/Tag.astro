---
interface Props {
  label: string;
  variant?: 'default' | 'accent' | 'outline';
  size?: 'sm' | 'md';
}

const { label, variant = 'default', size = 'sm' } = Astro.props;

const base = 'inline-flex items-center font-mono font-medium rounded-full border transition-colors duration-200';

const sizes = {
  sm: 'text-xs px-2.5 py-0.5',
  md: 'text-sm px-3 py-1',
};

const variants = {
  default: 'bg-[var(--color-accent-dim)] text-[var(--color-accent)] border-transparent',
  accent:  'bg-[var(--color-accent)] text-[var(--color-bg-primary)] border-transparent font-semibold',
  outline: 'bg-transparent text-[var(--color-text-secondary)] border-[var(--color-border)] hover:border-[var(--color-accent)] hover:text-[var(--color-accent)]',
};
---

<span class:list={[base, sizes[size], variants[variant]]}>
  {label}
</span>
