---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import Tag from '../../components/ui/Tag.astro';
import Button from '../../components/ui/Button.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import { SITE } from '../../config';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { title, client, description, longDescription, tags, year, metrics, links } = project.data;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={`${title} — ${SITE.title}`}
      description={description}
    />
  </head>
  <body>
    <Header />
    <main>
      <article class="section">
        <div class="container max-w-3xl">

          <!-- Back link -->
          <div class="pt-16 mb-10">
            <a
              href="/projects"
              class="inline-flex items-center gap-2 text-sm text-[var(--color-text-secondary)] hover:text-[var(--color-accent)] transition-colors no-underline"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="m15 18-6-6 6-6"/>
              </svg>
              All projects
            </a>
          </div>

          <!-- Header -->
          <header class="mb-12">
            <div class="flex items-center gap-3 mb-4">
              <span class="font-mono text-sm text-[var(--color-accent)] uppercase tracking-widest">{client}</span>
              <span class="text-[var(--color-border)]">·</span>
              <span class="font-mono text-sm text-[var(--color-text-secondary)]">{year}</span>
            </div>
            <h1 class="mb-6">{title}</h1>
            <p class="text-xl text-[var(--color-text-secondary)] leading-relaxed">{description}</p>
          </header>

          <!-- Metrics -->
          {metrics && metrics.length > 0 && (
            <div class="grid grid-cols-3 gap-4 mb-12 p-6 rounded-xl border border-[var(--color-border)] bg-[var(--color-bg-secondary)]">
              {metrics.map((m) => (
                <div class="text-center">
                  <div class="text-3xl font-bold text-[var(--color-accent)] mb-1">{m.value}</div>
                  <div class="text-xs text-[var(--color-text-secondary)]">{m.label}</div>
                </div>
              ))}
            </div>
          )}

          <!-- Full description -->
          {longDescription && (
            <div class="mb-12">
              <h2 class="text-xl font-bold mb-4">Overview</h2>
              <p class="text-[var(--color-text-secondary)] leading-relaxed">{longDescription}</p>
            </div>
          )}

          <!-- Technologies -->
          <div class="mb-12">
            <h2 class="text-xl font-bold mb-4">Technologies</h2>
            <div class="flex flex-wrap gap-2">
              {tags.map((tag) => <Tag label={tag} variant="default" size="md" />)}
            </div>
          </div>

          <!-- Links -->
          {links && (links.demo || links.repo) && (
            <div class="flex gap-4 pt-8 border-t border-[var(--color-border)]">
              {links.demo && <Button href={links.demo} variant="primary" external>Live Demo</Button>}
              {links.repo && <Button href={links.repo} variant="secondary" external>View Code</Button>}
            </div>
          )}

        </div>
      </article>
    </main>
    <Footer />
  </body>
</html>
