---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import ProjectCard from '../../components/projects/ProjectCard.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import { SITE } from '../../config';

const allProjects = await getCollection('projects');

// Sort: featured first, then by year desc
const sorted = [...allProjects].sort((a, b) => {
  if (a.data.featured !== b.data.featured) return a.data.featured ? -1 : 1;
  return b.data.year - a.data.year;
});

const clients = [...new Set(sorted.map((p) => p.data.client))];
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={`Projects — ${SITE.title}`}
      description="IoT systems, embedded hardware, and end-to-end deployments across energy, agriculture, and environmental sectors."
    />
  </head>
  <body>
    <Header />
    <main>
      <section class="section">
        <div class="container">

          <div class="pt-16 mb-16">
            <SectionHeading title="Portfolio" subtitle="Projects & Deployments" />
            <p class="text-[var(--color-text-secondary)] max-w-xl">
              End-to-end IoT solutions built for industry — from sensor hardware
              to cloud dashboards. Each project is a full-chain ownership story.
            </p>
          </div>

          <!-- Client filter pills -->
          <div class="flex flex-wrap gap-2 mb-10" id="filter-bar">
            <button
              class="filter-btn active font-mono text-xs px-3 py-1.5 rounded-full border border-[var(--color-accent)] bg-[var(--color-accent-dim)] text-[var(--color-accent)] transition-all cursor-pointer"
              data-filter="all"
            >
              All ({sorted.length})
            </button>
            {clients.map((client) => (
              <button
                class="filter-btn font-mono text-xs px-3 py-1.5 rounded-full border border-[var(--color-border)] text-[var(--color-text-secondary)] hover:border-[var(--color-accent)] hover:text-[var(--color-accent)] transition-all cursor-pointer"
                data-filter={client}
              >
                {client}
              </button>
            ))}
          </div>

          <!-- Projects grid -->
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="projects-grid">
            {sorted.map((project) => (
              <div class="project-item" data-client={project.data.client}>
                <ProjectCard project={project} />
              </div>
            ))}
          </div>

        </div>
      </section>
    </main>
    <Footer />
  </body>
</html>

<script>
  const filterBtns = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const projectItems = document.querySelectorAll<HTMLElement>('.project-item');
  let activeFilters: string[] = [];

  const activeClass = ['!border-[var(--color-accent)]', '!bg-[var(--color-accent-dim)]', '!text-[var(--color-accent)]'];
  const inactiveBase = ['border-[var(--color-border)]', 'text-[var(--color-text-secondary)]'];

  function applyDisplay() {
    const hasFilters = activeFilters.length > 0;
    projectItems.forEach((item) => {
      const client = item.dataset.client ?? '';
      const matches = !hasFilters || activeFilters.includes(client);
      item.style.display = matches ? '' : 'none';
    });
  }

  function updateAllBtn() {
    const allBtn = document.querySelector<HTMLButtonElement>('.filter-btn[data-filter="all"]');
    if (!allBtn) return;
    if (activeFilters.length === 0) {
      allBtn.classList.add(...activeClass);
      allBtn.classList.remove(...inactiveBase);
    } else {
      allBtn.classList.remove(...activeClass);
      allBtn.classList.add(...inactiveBase);
    }
  }

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const filter = btn.dataset.filter ?? '';

      if (filter === 'all') {
        activeFilters = [];
      } else {
        const idx = activeFilters.indexOf(filter);
        if (idx >= 0) {
          activeFilters.splice(idx, 1);
        } else {
          activeFilters.push(filter);
        }
      }

      // Update client btn styling
      filterBtns.forEach((b) => {
        const f = b.dataset.filter ?? '';
        if (f === 'all') return;
        if (activeFilters.includes(f)) {
          b.classList.add(...activeClass);
          b.classList.remove(...inactiveBase);
        } else {
          b.classList.remove(...activeClass);
          b.classList.add(...inactiveBase);
        }
      });

      updateAllBtn();
      applyDisplay();
    });
  });
</script>
