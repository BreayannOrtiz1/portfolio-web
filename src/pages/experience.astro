---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import ExperienceTimeline from '../components/experience/ExperienceTimeline.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import Tag from '../components/ui/Tag.astro';
import { AUTHOR, SITE } from '../config';

const allExperience = await getCollection('experience');

// Education data (static — not in CMS)
const education = [
  {
    institution: 'Pontificia Universidad Javeriana',
    degree: 'B.Eng. Electronic Engineering',
    focus: 'IoT & Renewable Energy',
    location: 'Bogotá D.C.',
    date: 'March 2022',
  },
  {
    institution: 'Universidad Nacional de Colombia',
    degree: 'Diploma — Photovoltaic Installations',
    focus: 'Solar system design & sizing',
    location: 'Bogotá D.C.',
    date: 'November 2023',
  },
];

const certifications = [
  'LFS101x — Introduction to Linux (edX)',
  'AZ-900 — Azure Fundamentals (Microsoft)',
  'Cloud Development with HTML, CSS, GIT and JavaScript',
];
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={`Experience — ${SITE.title}`}
      description="4+ years leading IoT deployments for ECOPETROL, CORNARE, and AGROSAVIA. Full career timeline and education."
    />
  </head>
  <body>
    <Header />
    <main>
      <section class="section">
        <div class="container">

          <div class="pt-16 mb-16 max-w-2xl">
            <SectionHeading title="Career" subtitle="Experience & Education" />
            <p class="text-[var(--color-text-secondary)] leading-relaxed">
              4+ years leading end-to-end IoT deployments across energy, agriculture,
              and environmental monitoring. Based in {AUTHOR.location}.
            </p>
          </div>

          <div class="grid grid-cols-1 lg:grid-cols-3 gap-16">

            <!-- Timeline (left, wider) -->
            <div class="lg:col-span-2">
              <h2 class="text-sm font-mono text-[var(--color-text-secondary)] uppercase tracking-widest mb-8">
                Work Experience
              </h2>
              <ExperienceTimeline entries={allExperience} compact={false} />
            </div>

            <!-- Sidebar (right) -->
            <div class="space-y-10">

              <!-- Education -->
              <div>
                <h2 class="text-sm font-mono text-[var(--color-text-secondary)] uppercase tracking-widest mb-6">
                  Education
                </h2>
                <div class="space-y-6">
                  {education.map((edu) => (
                    <div class="p-4 rounded-lg border border-[var(--color-border)] bg-[var(--color-bg-secondary)]">
                      <div class="font-mono text-xs text-[var(--color-text-secondary)] mb-1">{edu.date}</div>
                      <div class="font-semibold text-[var(--color-text-primary)] text-sm">{edu.degree}</div>
                      <div class="text-xs text-[var(--color-accent)] mt-0.5">{edu.focus}</div>
                      <div class="text-xs text-[var(--color-text-secondary)] mt-1">{edu.institution}</div>
                    </div>
                  ))}
                </div>
              </div>

              <!-- Certifications -->
              <div>
                <h2 class="text-sm font-mono text-[var(--color-text-secondary)] uppercase tracking-widest mb-6">
                  Certifications
                </h2>
                <ul class="space-y-3">
                  {certifications.map((cert) => (
                    <li class="flex gap-2 text-sm text-[var(--color-text-secondary)]">
                      <span class="mt-1.5 w-1 h-1 rounded-full bg-[var(--color-accent)] shrink-0"></span>
                      {cert}
                    </li>
                  ))}
                </ul>
              </div>

              <!-- Languages -->
              <div>
                <h2 class="text-sm font-mono text-[var(--color-text-secondary)] uppercase tracking-widest mb-6">
                  Languages
                </h2>
                <div class="space-y-3">
                  <div class="flex items-center justify-between">
                    <span class="text-sm text-[var(--color-text-primary)]">Spanish</span>
                    <Tag label="Native" variant="accent" size="sm" />
                  </div>
                  <div class="flex items-center justify-between">
                    <span class="text-sm text-[var(--color-text-primary)]">English</span>
                    <Tag label="B2" variant="default" size="sm" />
                  </div>
                </div>
              </div>

            </div>
          </div>
        </div>
      </section>
    </main>
    <Footer />
  </body>
</html>
